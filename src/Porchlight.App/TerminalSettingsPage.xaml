<Page x:Class="Porchlight.App.TerminalSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:Porchlight.App">
  <Page.Resources>
    <DataTemplate x:Key="FontNameTemplate" x:DataType="x:String">
      <TextBlock Text="{x:Bind}" FontFamily="{x:Bind}" />
    </DataTemplate>
    <DataTemplate x:Key="FeatureSuggestionTemplate" x:DataType="x:String">
      <Grid ColumnDefinitions="44,*" ColumnSpacing="12" DataContextChanged="FeatureSuggestionChanged">
        <TextBlock Text="{x:Bind}" VerticalAlignment="Center" />
        <local:FeatureComparison Grid.Column="1" HorizontalAlignment="Left" />
      </Grid>
    </DataTemplate>
  </Page.Resources>
  <ScrollViewer MaxWidth="840" VerticalScrollBarVisibility="Auto">
    <StackPanel Padding="24">
      <TextBlock x:Name="TerminalPageHeading" Text="Terminal" Margin="0,0,0,16" Style="{ThemeResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" />
      <local:TerminalAppearancePreview x:Name="AppearancePreview" />

      <TextBlock x:Name="TypographyHeading" Text="Typography" Margin="0,24,0,8" Style="{ThemeResource SubtitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
      <controls:SettingsCard x:Name="FontSettingsCard" Header="Font families" ContentAlignment="Vertical">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <controls:TokenizingTextBox x:Name="TerminalFontPicker" AutomationProperties.Name="Terminal font families"
              PlaceholderText="Type a font name…" TokenDelimiter="," TextChanged="FontQueryChanged" TokenItemAdding="FontAdding"
              TokenItemTemplate="{StaticResource FontNameTemplate}" SuggestedItemTemplate="{StaticResource FontNameTemplate}">
            <controls:TokenizingTextBox.Resources>
              <Thickness x:Key="TextBoxTopHeaderMargin">0</Thickness>
            </controls:TokenizingTextBox.Resources>
            <controls:TokenizingTextBox.QueryIcon><FontIconSource Glyph="&#xE721;" FontSize="12" /></controls:TokenizingTextBox.QueryIcon>
          </controls:TokenizingTextBox>
          <Button x:Name="ResetFontsButton" Grid.Column="1" Style="{StaticResource SubtleButtonStyle}" VerticalAlignment="Top"
                  AutomationProperties.Name="Reset fonts" ToolTipService.ToolTip="Reset to launch fonts" Click="ResetFonts">
            <FontIcon Glyph="&#xE777;" FontSize="16" />
          </Button>
        </Grid>
      </controls:SettingsCard>
      <controls:SettingsCard Header="Font size">
        <NumberBox x:Name="TerminalFontSize" Width="144" AutomationProperties.Name="Font size in points"
                   SpinButtonPlacementMode="Inline" SmallChange="1" Minimum="0" Maximum="128"
                   ValueChanged="FontSizeChanged" />
      </controls:SettingsCard>
      <controls:SettingsCard Header="Ligatures">
        <ToggleSwitch x:Name="CodingLigaturesSwitch" AutomationProperties.Name="Ligatures"
                      Toggled="LigaturesToggled" MinWidth="0" OnContent="" OffContent="" />
      </controls:SettingsCard>
      <controls:SettingsCard x:Name="FeaturesCard" Header="OpenType features" ContentAlignment="Vertical">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <controls:TokenizingTextBox x:Name="FeaturePicker" AutomationProperties.Name="OpenType features"
                PlaceholderText="Type a feature tag…" TokenDelimiter="," TextChanged="FeatureQueryChanged" GotFocus="FeaturePickerFocused" LostFocus="FeaturePickerLostFocus"
                TokenItemAdding="FeatureAdding" TokenItemAdded="FeatureAdded" TokenItemRemoved="FeatureRemoved"
                SuggestedItemTemplate="{StaticResource FeatureSuggestionTemplate}">
              <controls:TokenizingTextBox.Resources>
                <Thickness x:Key="TextBoxTopHeaderMargin">0</Thickness>
              </controls:TokenizingTextBox.Resources>
              <controls:TokenizingTextBox.QueryIcon><FontIconSource Glyph="&#xE721;" FontSize="12" /></controls:TokenizingTextBox.QueryIcon>
            </controls:TokenizingTextBox>
            <Button x:Name="ResetFeaturesButton" Grid.Column="1" Style="{StaticResource SubtleButtonStyle}" VerticalAlignment="Top" IsEnabled="False"
                    AutomationProperties.Name="Reset ligatures and OpenType features" ToolTipService.ToolTip="Reset ligatures and features to launch settings" Click="ResetFeatures">
              <FontIcon Glyph="&#xE777;" FontSize="16" />
            </Button>
          </Grid>
          <TextBlock x:Name="FeatureStatus" Visibility="Collapsed" TextWrapping="Wrap" />
        </StackPanel>
      </controls:SettingsCard>

      <TextBlock Text="Cursor" Margin="0,24,0,8" Style="{ThemeResource SubtitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
      <controls:SettingsCard Header="Shape">
        <local:AccessibleSegmented x:Name="CursorShapePicker" AutomationProperties.Name="Cursor shape"
                                   SelectionMode="Single" SelectionChanged="CursorShapeChanged" />
      </controls:SettingsCard>
    </StackPanel>
  </ScrollViewer>
</Page>
