<Window x:Class="Porchlight.App.MainWindow" Title="Porchlight"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">
  <Window.SystemBackdrop>
    <MicaBackdrop Kind="BaseAlt" />
  </Window.SystemBackdrop>
  <Grid SizeChanged="LayoutSizeChanged" RowDefinitions="Auto,*">
    <Grid x:Name="AppTitleBar" ColumnDefinitions="Auto,*,Auto" AutomationProperties.Name="Window title bar">
      <Grid MinWidth="{x:Bind SidebarSlot.Width, Mode=OneWay}" ColumnDefinitions="Auto,*">
        <ToggleButton x:Name="SidebarToggle" IsChecked="True" Checked="SidebarToggled" Unchecked="SidebarToggled" Width="28" Height="28" Margin="4,8,4,0" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Top"
                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="{ThemeResource TabViewButtonBackground}"
                      BorderThickness="{ThemeResource TabViewButtonBorderThickness}" BorderBrush="{ThemeResource TabViewButtonBorderBrush}"
                      AutomationProperties.Name="Machine and space sidebar" ToolTipService.ToolTip="Show or hide the sidebar">
          <ToggleButton.Resources>
            <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="TabViewButtonBackgroundPointerOver" />
            <StaticResource x:Key="ToggleButtonForegroundPointerOver" ResourceKey="TabViewButtonForegroundPointerOver" />
            <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="TabViewButtonBackgroundPressed" />
            <StaticResource x:Key="ToggleButtonForegroundPressed" ResourceKey="TabViewButtonForegroundPressed" />
            <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="TabViewButtonBackground" />
            <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TabViewButtonForeground" />
            <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="TabViewButtonBackgroundPointerOver" />
            <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TabViewButtonForegroundPointerOver" />
            <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="TabViewButtonBackgroundPressed" />
            <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TabViewButtonForegroundPressed" />
          </ToggleButton.Resources>
          <FontIcon Glyph="&#xE700;" FontSize="16" />
        </ToggleButton>
        <Grid x:Name="SidebarDragArea" Grid.Column="1" />
      </Grid>
      <Grid Grid.Column="1" SizeChanged="TabViewportSizeChanged" Clip="{x:Bind TabStripClip(SidebarToggle.IsChecked), Mode=OneWay}">
        <!-- Match WinUI's fractional header widths so rounding doesn't clip the selected tab's curves. -->
        <TabView x:Name="TerminalTabs" UseLayoutRounding="False" AutomationProperties.Name="Live terminals in this space"
                 Margin="{x:Bind TabStripMargin(SidebarToggle.IsChecked), Mode=OneWay}"
                 SelectedIndex="-1" SelectionChanged="TerminalSelected" TabWidthMode="SizeToContent"
                 CloseButtonOverlayMode="OnPointerOver" TabCloseRequested="TerminalCloseRequested"
                 IsAddTabButtonVisible="False" CanDragTabs="False" CanReorderTabs="False" AllowDropTabs="False">
          <TabView.Resources>
            <Style TargetType="primitives:TabViewListView">
              <!-- WinUI leaves 8 DIPs before the tab fill. Remove 4 here to leave room for the curve;
                   TabStripMargin removes the remaining 4 when the sidebar is open. -->
              <Setter Property="Margin" Value="-4,0,0,0" />
              <!-- A space change replaces a list; don't animate it as a sequence of tab opens/closes. -->
              <Setter Property="ItemContainerTransitions">
                <Setter.Value><TransitionCollection /></Setter.Value>
              </Setter>
            </Style>
          </TabView.Resources>
          <TabView.TabStripFooter>
            <Grid x:Name="TabDragArea" MinWidth="48" MinHeight="40" Background="Transparent" />
          </TabView.TabStripFooter>
        </TabView>
      </Grid>
      <StackPanel x:Name="CaptionButtons" Grid.Column="2" Orientation="Horizontal" Visibility="Collapsed">
        <StackPanel.Resources>
          <Style x:Key="CaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Width" Value="46" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
            <Setter Property="FontSize" Value="10" />
          </Style>
        </StackPanel.Resources>
        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonStyle}" Content="&#xE921;" Click="CaptionButtonClicked"
                AutomationProperties.AutomationId="Minimize" AutomationProperties.Name="Minimize" ToolTipService.ToolTip="Minimize" />
        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}" Content="&#xE922;" Click="CaptionButtonClicked"
                AutomationProperties.AutomationId="Maximize" AutomationProperties.Name="Maximize" ToolTipService.ToolTip="Maximize" />
        <Button x:Name="CloseButton" Style="{StaticResource CaptionButtonStyle}" Content="&#xE8BB;" Click="CaptionButtonClicked"
                AutomationProperties.AutomationId="Close" AutomationProperties.Name="Close" ToolTipService.ToolTip="Close">
          <Button.Resources>
            <StaticResource x:Key="SubtleButtonBackgroundPointerOver" ResourceKey="CloseButtonBackgroundPointerOver" />
            <StaticResource x:Key="SubtleButtonForegroundPointerOver" ResourceKey="CloseButtonStrokePointerOver" />
            <StaticResource x:Key="SubtleButtonBackgroundPressed" ResourceKey="CloseButtonBackgroundPressed" />
            <StaticResource x:Key="SubtleButtonForegroundPressed" ResourceKey="CloseButtonStrokePressed" />
          </Button.Resources>
        </Button>
      </StackPanel>
    </Grid>

    <Grid x:Name="Workspace" Grid.Row="1" ColumnDefinitions="Auto,*">
      <Grid x:Name="SidebarSlot" Width="0">
        <Grid x:Name="Sidebar" HorizontalAlignment="Right" Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource SystemControlForegroundTransparentBrush}" BorderThickness="0,0,1,0"
              Padding="12" RowDefinitions="*,Auto" RowSpacing="12">
          <ScrollViewer x:Name="MachineBrowser" AutomationProperties.Name="Machines" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="MachineGroups" Spacing="6" />
          </ScrollViewer>
          <StackPanel Grid.Row="1" Spacing="8">
            <TextBlock x:Name="Status" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <Button x:Name="SettingsButton" Style="{StaticResource SubtleButtonStyle}" Click="OpenSettings"
                    AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings">
              <FontIcon Glyph="&#xE713;" FontSize="16" />
            </Button>
          </StackPanel>
        </Grid>
      </Grid>

      <Border x:Name="WorkspaceFrame" Grid.Column="1" AutomationProperties.Name="Terminal workspace"
              Padding="4" Background="{ThemeResource TabViewItemHeaderBackgroundSelected}">
        <!-- Keep the rounded clip on the viewport: PaneHost can be wider during a sidebar slide. -->
        <Border CornerRadius="4">
          <Border x:Name="PaneHost" Background="#282c34" />
        </Border>
      </Border>
    </Grid>
  </Grid>
</Window>
