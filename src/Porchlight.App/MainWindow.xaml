<Window x:Class="Porchlight.App.MainWindow" Title="Porchlight"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid SizeChanged="LayoutSizeChanged" RowDefinitions="Auto,*">
    <Grid Padding="8,4" ColumnDefinitions="Auto,*" ColumnSpacing="12">
      <ToggleButton x:Name="SidebarToggle" IsChecked="True"
                    AutomationProperties.Name="Machine and space sidebar" ToolTipService.ToolTip="Show or hide the sidebar">
        <FontIcon Glyph="&#xE700;" FontSize="16" />
      </ToggleButton>
      <TextBlock x:Name="ScopeLabel" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                 Style="{ThemeResource BodyStrongTextBlockStyle}" Text="No space selected" />
    </Grid>

    <SplitView x:Name="Workspace" Grid.Row="1" DisplayMode="Inline" OpenPaneLength="280"
               IsPaneOpen="{Binding IsChecked, ElementName=SidebarToggle, Mode=TwoWay}"
               PaneBackground="{ThemeResource LayerFillColorDefaultBrush}">
      <SplitView.Pane>
        <Grid Padding="12" RowDefinitions="Auto,*,Auto" RowSpacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Machines" VerticalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <Button x:Name="RefreshMachinesButton" Grid.Column="1" Style="{StaticResource SubtleButtonStyle}"
                    AutomationProperties.Name="Refresh machines" ToolTipService.ToolTip="Refresh machine connections" Click="RefreshMachines_Click">
              <FontIcon Glyph="&#xE72C;" FontSize="16" />
            </Button>
          </Grid>
          <TextBlock x:Name="EmptyMachines" Grid.Row="1" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     Text="Machines and spaces appear when the gateway connects. Use the refresh button to retry." />
          <ScrollViewer x:Name="MachineBrowser" Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="MachineGroups" Spacing="6" />
          </ScrollViewer>
          <TextBlock x:Name="CoreLabel" Grid.Row="2" Style="{ThemeResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Not connected" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        </Grid>
      </SplitView.Pane>

      <Grid Padding="12" RowSpacing="8" RowDefinitions="Auto,Auto,*">
        <ComboBox x:Name="Picker" Header="Live terminal" HorizontalAlignment="Stretch" PlaceholderText="Select a terminal to view"
                  SelectionChangedTrigger="Committed" SelectionChanged="TerminalSelected" />
        <TextBlock x:Name="Status" Grid.Row="1" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        <Border x:Name="PaneHost" Grid.Row="2" Background="#282c34" CornerRadius="4" />
      </Grid>
    </SplitView>
  </Grid>
</Window>
