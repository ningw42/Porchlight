<UserControl x:Class="Porchlight.App.MachineSpaceGroup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="using:Porchlight.Core">
  <Expander x:Name="Group" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0">
    <Expander.Header>
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="0,4">
        <Grid VerticalAlignment="Center">
          <FontIcon x:Name="OnlineIcon" Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}" ToolTipService.ToolTip="Connected" />
          <FontIcon x:Name="OfflineIcon" Glyph="&#xE7BA;" FontSize="16" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="MachineName" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="StateLabel" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </Grid>
    </Expander.Header>
    <ListView x:Name="Spaces" Margin="4" SelectionMode="Single" SelectionChanged="SpaceSelectionChanged"
              ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="core:TerminalSpace">
          <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Expander>
</UserControl>
